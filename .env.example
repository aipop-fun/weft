# ---------- LLM ----------
# Provider: anthropic | openrouter
# Se ambos os keys existirem e LLM_PROVIDER não for setado, anthropic tem prioridade.

# --- OpenRouter (grátis para testar) ---
# 1. Gere uma key em https://openrouter.ai/keys
# 2. Coloque abaixo
# 3. Modelos :free custam $0 (rate limit: 20/min, 50/dia sem $10 comprados)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODEL=deepseek/deepseek-r1:free
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free
# OPENROUTER_MODEL=google/gemma-3-27b-it:free

# --- Anthropic (produção) ---
ANTHROPIC_API_KEY=
WEFT_MODEL=claude-sonnet-4-5

# Força um provider mesmo quando ambos os keys existem.
# LLM_PROVIDER=openrouter

# ---------- GitHub App ----------
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=seu_segredo_aqui

# ---------- Servidor ----------
PORT=3000
WEB_PORT=3001
WEFT_DB=./data/weft.db
WEFT_URL=http://localhost:3000
WEFT_WEB=http://localhost:3001

# ---------- Feedback ----------
WEFT_FEEDBACK_URL=https://weft.dev/feedback
